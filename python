from model.load import load_model, fetch_db_record

load_dotenv()
AWS_REGION = os.getenv("AWS_REGION", "")

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)
logging.getLogger("strands.telemetry.metrics").setLevel(logging.INFO)

aws_session = boto3.Session(region_name=AWS_REGION)

# ========================================================
# DATABASE QUERY & IN-MEMORY CACHING
# ========================================================
AGENT_CONFIG_QUERY = """
    SELECT 
        llm.model_id, llm.temperature, llm.top_k, 
        llm.prompt_caching_option, llm.prompt_cache_ttl,
        p.prompt_id, p.prompt_version
    FROM agent_llm_config llm
    LEFT JOIN agent_prompt_config p ON llm.agent_id = p.agent_id
    WHERE llm.agent_name = %s;
"""

_CACHED_DB_CONFIG = None

def get_cached_agent_config(agent_name: str) -> dict:
    """
    Fetches agent config from memory. 
    If not initialized, executes the query using the generic DB function.
    """
    global _CACHED_DB_CONFIG
    
    if _CACHED_DB_CONFIG is not None:
        logger.info(f"⚡ [MEMORY CACHE HIT] Using stored config for '{agent_name}'.")
        return _CACHED_DB_CONFIG

    logger.info(f"🐌 [CACHE MISS] Fetching config for '{agent_name}' from Database...")
    
    # Pass the query and parameters to our generic DB function
    raw_config = fetch_db_record(query=AGENT_CONFIG_QUERY, params=(agent_name,))
    
    if raw_config:
        # Map enum strings into old boolean logic expected by the agent
        cache_option = raw_config.get('prompt_caching_option', 'none')
        raw_config['enable_system_cache'] = cache_option in ['system', 'system_and_tools']
        raw_config['enable_tool_cache'] = cache_option == 'system_and_tools'
        raw_config['ttl'] = raw_config.get('prompt_cache_ttl') or '5m'
        
        _CACHED_DB_CONFIG = raw_config
        logger.info(f"💾 Saved config for '{agent_name}' to application memory.")
    else:
        logger.warning(f"No config found in DB for '{agent_name}'. Falling back to defaults.")
        _CACHED_DB_CONFIG = {
            "model_id": "global.anthropic.claude-sonnet-4-5-20250929-v1:0",
            "temperature": 0.20,
            "top_k": 50,
            "enable_system_cache": True,
            "enable_tool_cache": False,
            "prompt_id": "",
            "prompt_version": "",
            "ttl": "5m"
        }
        
    return _CACHED_DB_CONFIG


# Fetch DB config to get the Prompt ID & Version
db_config_global = get_cached_agent_config("SummarizerAgent")
AWS_PROMPT_ID = db_config_global.get("prompt_id", "")
AWS_PROMPT_VERSION = db_config_global.get("prompt_version", "")

tools = []
bedrock_agent_client = aws_session.client('bedrock-agent')

def get_bedrock_system_prompt(prompt_id: str, prompt_version: str, **variables) -> dict:
    """Fetches strictly the prompt text from AWS Bedrock."""
    PROMPT = {
        "text": "",
    }
    
    if not prompt_id:
        logger.warning("AWS_PROMPT_ID is not set. Returning empty configuration.")
        return PROMPT["text"]

    max_retries = 3
    for attempt in range(1, max_retries + 1):
        try:
            logger.info(f"Attempting to fetch prompt from Bedrock (ID: {prompt_id}, Version: {prompt_version}) - Try {attempt}")
            
            response = bedrock_agent_client.get_prompt(
                promptIdentifier=prompt_id,
                promptVersion=prompt_version
            )
            prompt_data = response.get("variants", [])[0].get("templateConfiguration", {})
            
            if "text" in prompt_data:
                PROMPT["text"] = prompt_data["text"].get("text", "")
            elif "chat" in prompt_data:
                chat_data = prompt_data["chat"]
                for sys_block in chat_data.get("system", []):
                    if "text" in sys_block:
                        PROMPT["text"] += sys_block["text"]
                if not PROMPT["text"]:
                    for msg in chat_data.get("messages", []):
                        for content in msg.get("content", []):
                            if "text" in content:
                                PROMPT["text"] += content["text"]

            for key, value in variables.items():
                PROMPT["text"] = PROMPT["text"].replace(f"{{{{{key}}}}}", str(value))
            logger.info(f"Successfully fetched prompt from Bedrock.")
            logger.info(f"Prompt text: {PROMPT['text']}")
            return PROMPT["text"]

        except Exception as e:
            if attempt < max_retries:
                time.sleep(2)
            else:
                logger.error(f"Failed to fetch prompt from Bedrock after {max_retries} attempts: {e}.")
                return PROMPT["text"]

dynamic_prompt_variables = {}

SYSTEM_PROMPT = get_bedrock_system_prompt(
    prompt_id=AWS_PROMPT_ID,
    prompt_version=AWS_PROMPT_VERSION,
    **dynamic_prompt_variables
)

# ========================================================
# LOGGING METRICS (Strictly Per-Request)
# ========================================================
def log_metrics_on_complete(event: AfterInvocationEvent) -> None:
    if not event.result or not event.result.metrics:
        return

    if event.result.metrics.agent_invocations:
        latest_invocation = event.result.metrics.agent_invocations[-1]
        metrics = latest_invocation.usage
        cycle_count = len(latest_invocation.cycles)
    else:
        metrics = event.result.metrics.accumulated_usage
        cycle_count = 1

    input_t = metrics.get('inputTokens', 0)
    output_t = metrics.get('outputTokens', 0)
    cache_w = metrics.get('cacheWriteInputTokens', 0)
    cache_r = metrics.get('cacheReadInputTokens', 0)
    total_tokens = metrics.get('totalTokens', 0)
    billed_tokens = total_tokens - cache_r

    dashboard = (
        f"\n"
        f"┌──────────────────────────────────────────────────┐\n"
        f"│ 📊 ANALYZER SINGLE-REQUEST METRICS               │\n"
        f"├──────────────────────────────────────────────────┤\n"
        f"│ 🔄 Agent Cycles    : {cycle_count}\n"
        f"│ 📥 Standard Input  : {input_t} tokens\n"
        f"│ 📤 Output Generated: {output_t} tokens\n"
        f"│ 💾 Cache Written   : {cache_w} tokens\n"
        f"│ ⚡ Cache Read      : {cache_r} tokens (Discounted!)\n"
        f"├──────────────────────────────────────────────────┤\n"
        f"│ 📈 Total Processed : {total_tokens} tokens\n"
        f"│ 📈 Billed Tokens   : {billed_tokens} tokens\n"
        f"└──────────────────────────────────────────────────┘\n"
    )
    logger.info(dashboard)


def main():
    is_local = os.getenv("ENV", "prod").lower() == "local"

    # 1. Fetch config (will hit cache in memory since it was already fetched globally above)
    db_config = get_cached_agent_config(agent_name="SummarizerAgent")
    TTL = db_config.get("ttl", "5m")

    # 2. Build system blocks and dynamically check caching flag from DB
    system_blocks = [SystemContentBlock(text=SYSTEM_PROMPT)]
    if db_config.get("enable_system_cache", False):
        cache_config = {"type": "default"}

        if db_config.get("ttl") == "1h": 
            cache_config["ttl"] = db_config["ttl"]

        system_blocks.append(SystemContentBlock(cachePoint=cache_config))
        logger.info(f"System cache point dynamically applied from DB flag: {cache_config}")
    
    # 3. Load model passing the direct config
    MODEL_ID_DB = load_model(db_config=db_config)
    logger.info("Fetched configuration and initialized model:")
    print(vars(MODEL_ID_DB))
    
    summarizer_agent = Agent(
        name="Summarizer Agent",    
        description="Provides an immediate specialist summary on incident data.", 
        model=MODEL_ID_DB,
        system_prompt=system_blocks,
        tools=tools
    )

    summarizer_agent.add_hook(log_metrics_on_complete, AfterInvocationEvent)

    if is_local:
        logger.info("Running Summarizer Agent in LOCAL mode on port 9003...")
        a2a_server = A2AServer(
            agent=summarizer_agent, 
            port=9003
        )
        a2a_server.serve()
    else:
        logger.info("Running Summarizer Agent in AWS PRODUCTION environment via Bedrock AgentCore Runtime...")
        executor = StrandsA2AExecutor(agent=summarizer_agent)
        serve_a2a(executor)

if __name__ == "__main__":
    main()
