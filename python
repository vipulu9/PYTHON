import boto3
import logging
import json
import os
from dotenv import load_dotenv
load_dotenv()

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

def deploy_or_update_prompt():
    """
    Checks if a specific prompt exists in AWS Bedrock.
    Updates it if found, creates it if not, and publishes a locked version.
    Supports dynamic injection of prompt caching checkpoints via the CACHE_MODE env var.
    """
    client = boto3.client('bedrock-agent', region_name='us-east-1')
    
    prompt_name = os.getenv("PROMPT_NAME", "")
    system_text = os.getenv("SYSTEM_TEXT", "")
    cache_mode = os.getenv("CACHE_MODE", "none").lower() # "none", "tools", or "tools_system"

    # ==========================================
    # CONSTRUCT CACHE-AWARE CHAT PAYLOAD
    # ==========================================
    
    # 1. Start with the base system instruction
    system_block = [{"text": system_text}]
    
    # 2. Add system cache point if requested
    if cache_mode == "tools_system":
        system_block.append({"cachePoint": {"type": "default"}})

    # 3. Define the dummy anchor tool (required to attach tool cache)
    dummy_tool = {
        "toolSpec": {
            "name": "cache_anchor_tool",
            "description": "A structural anchor to hold Anthropic cache wall inplace. Do not call this",
            "inputSchema": {
                "json": {
                    "type": "object",
                    "properties": {},
                    "required": []
                }
            }
        }
    }
    
    # 4. Build the tool configuration list
    tool_list = [dummy_tool]
    
    # 5. Add the tool cache point if tools OR system caching is requested
    if cache_mode in ["tools", "tools_system"]:
        tool_list.append({"cachePoint": {"type": "default"}})

    # 6. Construct the final dynamic variant payload
    prompt_variant = {
        "name": "PrimaryVariant",
        "templateType": "CHAT",
        "templateConfiguration": {
            "chat": {
                "system": system_block,
                "toolConfiguration": {
                    "tools": tool_list
                },
                "messages": [] 
            }
        },
        "modelId": "anthropic.claude-3-sonnet-20240229-v1:0",
        "inferenceConfiguration": {
            "text": {
                "temperature": 0.0,
                "topP": 1.0,
                "maxTokens": 2000,
                "stopSequences": []
            }
        }
    }

    try:
        # ==========================================
        # STEP 1: Search for existing prompt by name
        # ==========================================
        logger.info(f"Checking if prompt '{prompt_name}' already exists in AWS...")
        existing_prompt_id = None

        paginator = client.get_paginator('list_prompts')
        for page in paginator.paginate():
            for summary in page.get('promptSummaries', []):
                if summary['name'] == prompt_name:
                    existing_prompt_id = summary['id']
                    break
            if existing_prompt_id:
                break

        # ==========================================
        # STEP 2: Execute Update or Create
        # ==========================================
        if existing_prompt_id:
            logger.info(f"Match found! Updating existing prompt (ID: {existing_prompt_id}) with Cache Mode: {cache_mode}...")
            # Update the existing DRAFT
            client.update_prompt(
                promptIdentifier=existing_prompt_id,
                name=prompt_name,
                description="Automated prompt update",
                defaultVariant="PrimaryVariant",
                variants=[prompt_variant]
            )
            final_prompt_id = existing_prompt_id
            logger.info("Successfully updated the DRAFT version.")
        else:
            logger.info(f"No match found. Creating new prompt '{prompt_name}' with Cache Mode: {cache_mode}...")

            # Create a brand new DRAFT
            create_response = client.create_prompt(
                name=prompt_name,
                description="Automated prompt creation",
                defaultVariant="PrimaryVariant",
                variants=[prompt_variant]
            )

            final_prompt_id = create_response['id']
            logger.info(f"Successfully created a new prompt. ID: {final_prompt_id}")

        # ==========================================
        # STEP 3: Lock and Publish a New Version
        # ==========================================
        logger.info("Publishing a new locked version for production...")

        version_response = client.create_prompt_version(
            promptIdentifier=final_prompt_id,
            description=f"Automated deployment publish (Cache: {cache_mode})"
        )

        locked_version = version_response['version']

        logger.info("DEPLOYMENT PIPELINE SUCCESSFUL")
        logger.info(f"PROMPT ID: {final_prompt_id}")
        logger.info(f"VERSION:   {locked_version}")

        return final_prompt_id, locked_version

    except Exception:
        logger.exception("Deployment failed")
        return None, None

if __name__ == "__main__":
    deploy_or_update_prompt()
