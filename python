import os
import logging
from dotenv import load_dotenv
from strands import Agent
from strands.multiagent.a2a.executor import StrandsA2AExecutor
from strands.multiagent.a2a import A2AServer
from bedrock_agentcore.runtime import serve_a2a
from strands.hooks import AfterInvocationEvent
from strands.types.content import SystemContentBlock

from model.load import load_model
from base_framework.db_config_provider import AgentConfigLoader

load_dotenv()

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)
logging.getLogger("strands.telemetry.metrics").setLevel(logging.INFO)

# ========================================================
# CONFIG LOADING
# ========================================================
DEFAULT_DB_CONFIG = {
    "model_id": "global.anthropic.claude-sonnet-4-5-20250929-v1:0",
    "temperature": 0.20,
    "top_k": 50,
    "enable_system_cache": True,
    "enable_tool_cache": False,
    "prompt_caching_option": "system",
    "prompt_cache_ttl": "5m",
}

logger.info("Loading config for 'summarizer_agent' using AgentConfigLoader...")
loaded_config = AgentConfigLoader(agent_name="summarizer_agent").load()

db_config_global = loaded_config.get("model_config") or {}
if db_config_global:
    db_config_global["prompt_cache_ttl"] = db_config_global.get("prompt_cache_ttl") or "5m"
    logger.info("Successfully loaded database configuration.")
else:
    logger.warning("No config found from AgentConfigLoader. Falling back to defaults.")
    db_config_global = dict(DEFAULT_DB_CONFIG)

SYSTEM_PROMPT = loaded_config.get("system_prompt", "")
if not SYSTEM_PROMPT:
    logger.warning("System prompt from AgentConfigLoader is empty. Ensure the prompt is correctly configured in your DB/Framework.")
    SYSTEM_PROMPT = "You are a helpful Summarizer Agent." # Fallback to prevent runtime failure

tools = []

# ========================================================
# LOGGING METRICS (Strictly Per-Request)
# ========================================================
def log_metrics_on_complete(event: AfterInvocationEvent) -> None:
    if not event.result or not event.result.metrics:
        return

    if event.result.metrics.agent_invocations:
        latest_invocation = event.result.metrics.agent_invocations[-1]
        metrics = latest_invocation.usage
        cycle_count = len(latest_invocation.cycles)
    else:
        metrics = event.result.metrics.accumulated_usage
        cycle_count = 1

    input_t = metrics.get('inputTokens', 0)
    output_t = metrics.get('outputTokens', 0)
    cache_w = metrics.get('cacheWriteInputTokens', 0)
    cache_r = metrics.get('cacheReadInputTokens', 0)
    total_tokens = metrics.get('totalTokens', 0)
    billed_tokens = total_tokens - cache_r

    dashboard = (
        f"\n"
        f"┌──────────────────────────────────────────────────┐\n"
        f"│ 📊 SUMMARIZER SINGLE-REQUEST METRICS             │\n"
        f"├──────────────────────────────────────────────────┤\n"
        f"│ 🔄 Agent Cycles    : {cycle_count}\n"
        f"│ 📥 Standard Input  : {input_t} tokens\n"
        f"│ 📤 Output Generated: {output_t} tokens\n"
        f"│ 💾 Cache Written   : {cache_w} tokens\n"
        f"│ ⚡ Cache Read      : {cache_r} tokens (Discounted!)\n"
        f"├──────────────────────────────────────────────────┤\n"
        f"│ 📈 Total Processed : {total_tokens} tokens\n"
        f"│ 📈 Billed Tokens   : {billed_tokens} tokens\n"
        f"└──────────────────────────────────────────────────┘\n"
    )
    logger.info(dashboard)


def main():
    is_local = os.getenv("ENV", "prod").lower() == "local"

    # 1. Build system blocks and dynamically check caching flag from globally fetched DB config
    system_blocks = [SystemContentBlock(text=SYSTEM_PROMPT)]

    caching_option = db_config_global.get("prompt_caching_option", "none")

    if caching_option in ['system', 'system_and_tools']:
        cache_config = {"type": "default"}
        TTL = db_config_global.get("prompt_cache_ttl", "5m")
        if TTL:
            cache_config["ttl"] = TTL

        system_blocks.append(SystemContentBlock(cachePoint=cache_config))
        logger.info(f"System cache point dynamically applied from DB flag: {cache_config}")
    
    # 2. Load model passing the direct config
    MODEL_ID_DB = load_model(db_config=db_config_global)
    logger.info("Fetched configuration and initialized model:")
    logger.info(vars(MODEL_ID_DB))
    
    summarizer_agent = Agent(
        name="Summarizer Agent",    
        description="Provides an immediate specialist summary on incident data.", 
        model=MODEL_ID_DB,
        system_prompt=system_blocks,
        tools=tools
    )

    summarizer_agent.add_hook(log_metrics_on_complete, AfterInvocationEvent)

    if is_local:
        logger.info("Running Summarizer Agent in LOCAL mode on port 9003...")
        a2a_server = A2AServer(
            agent=summarizer_agent, 
            port=9003
        )
        a2a_server.serve()
    else:
        logger.info("Running Summarizer Agent in AWS PRODUCTION environment via Bedrock AgentCore Runtime...")
        executor = StrandsA2AExecutor(agent=summarizer_agent)
        serve_a2a(executor)

if __name__ == "__main__":
    main()
