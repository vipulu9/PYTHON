def main():
    is_local = os.getenv("ENV", "prod").lower() == "local"
    
    # 1. Dynamically build the system prompt blocks based ONLY on Bedrock flags
    system_blocks = [SystemContentBlock(text=PROMPT_DATA["text"])]
    if PROMPT_DATA["has_system_cache"]:
        system_blocks.append(SystemContentBlock(cachePoint={"type": "default"}))
        logger.info("System cache point dynamically applied.")
    
    # 2. Pass the tool cache flag to your model loader
    MODEL_ID_DB = load_model(
        agent_name="Summarizer Agent", 
        enable_tool_cache=PROMPT_DATA["has_tool_cache"]
    )
    
    summarizer_agent = Agent(
        name="Summarizer Agent",    
        description="Provides an immediate specialist summary on incident data.", 
        model=MODEL_ID_DB,
        system_prompt=system_blocks,
        tools=tools,
        structured_output_model=IncidentSummary,
    )

    summarizer_agent.add_hook(log_metrics_on_complete, AfterInvocationEvent)

    if is_local:
        logger.info("Running Summarizer Agent in LOCAL mode on port 9003...")
        a2a_server = A2AServer(
            agent=summarizer_agent, 
            port=9003
        )
        a2a_server.serve()
    else:
        logger.info("Running Summarizer Agent in AWS PRODUCTION environment...")
        executor = StrandsA2AExecutor(agent=summarizer_agent)
        serve_a2a(executor)

if __name__ == "__main__":
    main()
