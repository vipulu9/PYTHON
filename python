import { AssistantMessage } from "@/components/chat/messages/AssistantMessage";
import {
  A2UIDynamicFormMessageView,
  NotificationMessageView,
  StatusCardMessageView,
  TableMessageView,
  WorkflowProgressMessageView
} from "@/components/chat/messages/FutureMessages";
import { FormMessage } from "@/components/chat/messages/FormMessage";
import { SystemMessage } from "@/components/chat/messages/SystemMessage";
import { UserMessage } from "@/components/chat/messages/UserMessage";
import type { ProvisioningFormValues } from "@/types/forms";
import type {
  A2UIDynamicFormMessage,
  ChatMessage,
  FormMessage as FormMessageType
} from "@/types/message";

export interface ReviewEditableProperty {
  type: "string" | "number" | "integer" | "boolean" | "array" | "object";
  label: string;
  description?: string;
  enum?: string[];
  readOnly?: boolean;
  hidden?: boolean;
}

export interface ReviewEditableConfig {
  values: Record<string, unknown>;
  required: string[];
  properties: Record<string, ReviewEditableProperty>;
}

interface MessageRendererProps {
  message: ChatMessage;
  onFormSubmit: (
    message: FormMessageType,
    values: ProvisioningFormValues
  ) => void;
  onA2UIFormSubmit: (message: A2UIDynamicFormMessage, values: Record<string, unknown>) => void;
  onSendMessage?: (content: string) => void;
  reviewEditableConfig?: ReviewEditableConfig;
}

export function MessageRenderer({
  message,
  onFormSubmit,
  onA2UIFormSubmit,
  onSendMessage,
  reviewEditableConfig
}: MessageRendererProps) {
  if (message.kind === "form") {
    return <FormMessage message={message} onSubmit={onFormSubmit} />;
  }

  if (message.kind === "status-card") {
    return <StatusCardMessageView message={message} />;
  }

  if (message.kind === "notification") {
    return <NotificationMessageView message={message} />;
  }

  if (message.kind === "table") {
    return <TableMessageView message={message} />;
  }

  if (message.kind === "a2ui-form") {
    return <A2UIDynamicFormMessageView message={message} onSubmit={onA2UIFormSubmit} />;
  }

  if (message.kind === "workflow-progress") {
    return <WorkflowProgressMessageView message={message} />;
  }

  if (message.role === "user") {
    return <UserMessage message={message} />;
  }

  if (message.role === "system") {
    return <SystemMessage message={message} />;
  }

  return (
    <AssistantMessage
      message={message}
      onSendMessage={onSendMessage}
      reviewEditableConfig={reviewEditableConfig}
    />
  );
}
