import boto3
import logging
import json
import os
from dotenv import load_dotenv

load_dotenv()

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

def deploy_or_update_prompt():
    """
    Checks if a specific prompt exists in AWS Bedrock.
    Updates it if found, creates it if not, and publishes a locked version.
    
    Supports CACHE_MODE env var:
      - "none"         : No cache points added
      - "tools"        : Tool configuration cached
      - "tools_system" : Both tool configuration and system instruction cached
    """
    client = boto3.client('bedrock-agent', region_name='us-east-1')
    
    prompt_name = os.getenv("PROMPT_NAME", "")
    system_text = os.getenv("SYSTEM_TEXT", "")
    cache_mode = os.getenv("CACHE_MODE", "none").lower() # "none", "tools", or "tools_system"

    # ==========================================
    # STEP 1: Build CHAT Template Payload
    # ==========================================
    
    # Base prompt text placed in messages array (Bedrock standard for CHAT templates)
    chat_config = {
        "messages": [
            {
                "role": "user",
                "content": [{"text": system_text}]
            }
        ],
        "system": []
    }

    # Inject system cache point if tools_system is selected
    if cache_mode == "tools_system":
        chat_config["system"].append({"cachePoint": {"type": "default"}})

    # Attach tool anchor + cache point if tool/system caching is enabled
    if cache_mode in ["tools", "tools_system"]:
        chat_config["toolConfiguration"] = {
            "tools": [
                {
                    "toolSpec": {
                        "name": "cache_anchor_tool",
                        "description": "A structural anchor to hold Anthropic cache wall inplace. Do not call this",
                        "inputSchema": {
                            "json": {
                                "type": "object",
                                "properties": {},
                                "required": []
                            }
                        }
                    }
                },
                {"cachePoint": {"type": "default"}}
            ]
        }

    # Final variant payload structure
    prompt_variant = {
        "name": "PrimaryVariant",
        "templateType": "CHAT",
        "templateConfiguration": {
            "chat": chat_config
        },
        "modelId": "anthropic.claude-3-sonnet-20240229-v1:0",
        "inferenceConfiguration": {
            "text": {
                "temperature": 0.0,
                "topP": 1.0,
                "maxTokens": 2000,
                "stopSequences": []
            }
        }
    }

    try:
        # ==========================================
        # STEP 2: Search for existing prompt by name
        # ==========================================
        logger.info(f"Checking if prompt '{prompt_name}' already exists in AWS...")
        existing_prompt_id = None

        paginator = client.get_paginator('list_prompts')
        for page in paginator.paginate():
            for summary in page.get('promptSummaries', []):
                if summary['name'] == prompt_name:
                    existing_prompt_id = summary['id']
                    break
            if existing_prompt_id:
                break

        # ==========================================
        # STEP 3: Execute Update or Create
        # ==========================================
        if existing_prompt_id:
            logger.info(f"Match found! Updating prompt (ID: {existing_prompt_id}) | Mode: {cache_mode}")
            client.update_prompt(
                promptIdentifier=existing_prompt_id,
                name=prompt_name,
                description=f"Automated update (Cache: {cache_mode})",
                defaultVariant="PrimaryVariant",
                variants=[prompt_variant]
            )
            final_prompt_id = existing_prompt_id
            logger.info("Successfully updated DRAFT version.")
        else:
            logger.info(f"Creating new prompt '{prompt_name}' | Mode: {cache_mode}")
            create_response = client.create_prompt(
                name=prompt_name,
                description=f"Automated creation (Cache: {cache_mode})",
                defaultVariant="PrimaryVariant",
                variants=[prompt_variant]
            )
            final_prompt_id = create_response['id']
            logger.info(f"Successfully created new prompt. ID: {final_prompt_id}")

        # ==========================================
        # STEP 4: Lock and Publish Version
        # ==========================================
        logger.info("Publishing a new locked version...")

        version_response = client.create_prompt_version(
            promptIdentifier=final_prompt_id,
            description=f"Published deployment (Cache: {cache_mode})"
        )

        locked_version = version_response['version']

        logger.info("DEPLOYMENT SUCCESSFUL")
        logger.info(f"PROMPT ID : {final_prompt_id}")
        logger.info(f"VERSION   : {locked_version}")

        return final_prompt_id, locked_version

    except Exception:
        logger.exception("Deployment failed")
        return None, None

if __name__ == "__main__":
    deploy_or_update_prompt()
