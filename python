#fetching system prompt
def get_bedrock_system_prompt(prompt_id: str, prompt_version: str, **variables) -> dict:
    """
    Fetches strictly the prompt text and cache points from AWS Bedrock, 
    ignoring inference parameters like temperature or top_k.
    """
    config_result = {
        "text": "",
        "has_system_cache": False,
        "has_tool_cache": False
    }
    
    if not prompt_id:
        logger.warning("AWS_PROMPT_ID is not set. Returning empty configuration.")
        return config_result

    max_retries = 3
    for attempt in range(1, max_retries + 1):
        try:
            logger.info(f"Attempting to fetch prompt from Bedrock (ID: {prompt_id}, Version: {prompt_version}) - Try {attempt}")
            
            response = bedrock_agent_client.get_prompt(
                promptIdentifier=prompt_id,
                promptVersion=prompt_version
            )
            print(response)
            # Navigate directly to the text/chat templates, ignoring model/inference configs
            prompt_data = response.get("variants", [])[0].get("templateConfiguration", {})
            
            if "text" in prompt_data:
                config_result["text"] = prompt_data["text"].get("text", "")
                config_result["has_system_cache"] = "cachePoint" in prompt_data["text"]
                
            elif "chat" in prompt_data:
                chat_data = prompt_data["chat"]
                
                # 1. Check system block for text and cache points
                for sys_block in chat_data.get("system", []):
                    if "text" in sys_block:
                        config_result["text"] += sys_block["text"]
                    if "cachePoint" in sys_block:
                        config_result["has_system_cache"] = True
                
                # 2. If text is still empty, AWS placed it in the messages array
                if not config_result["text"]:
                    for msg in chat_data.get("messages", []):
                        for content in msg.get("content", []):
                            if "text" in content:
                                config_result["text"] += content["text"]
                
                # 3. Check tool configuration for cache points
                tools = chat_data.get("toolConfiguration", {}).get("tools", [])
                config_result["has_tool_cache"] = any("cachePoint" in t for t in tools)

                if config_result["has_system_cache"]:
                    config_result["has_tool_cache"] = True

            # Inject dynamic variables
            for key, value in variables.items():
                config_result["text"] = config_result["text"].replace(f"{{{{{key}}}}}", str(value))

            logger.info("Successfully extracted prompt text and cache flags from Bedrock.")
            logger.info(config_result["text"])
            return config_result

        except Exception as e:
            if attempt < max_retries:
                time.sleep(2)
            else:
                logger.error(f"Failed to fetch prompt from Bedrock after {max_retries} attempts: {e}.")
                return config_result

# Define dynamic variables based on environment and constants
dynamic_prompt_variables = {}

