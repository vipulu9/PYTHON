def get_bedrock_system_prompt(prompt_id: str, prompt_version: str, **variables) -> dict:
    """
    Fetches the system prompt and inference configurations from AWS Bedrock.
    Returns a dictionary with the prompt text and cache configurations.
    """
    config_result = {
        "text": "",
        "has_system_cache": False,
        "has_tool_cache": False
    }
    
    if not prompt_id:
        logger.warning("AWS_PROMPT_ID is not set. Returning empty configuration.")
        return config_result

    max_retries = 3
    for attempt in range(1, max_retries + 1):
        try:
            logger.info(f"Attempting to fetch configuration from Bedrock (ID: {prompt_id}, Version: {prompt_version}) - Try {attempt}")
            
            response = bedrock_agent_client.get_prompt(
                promptIdentifier=prompt_id,
                promptVersion=prompt_version
            )
            
            variants = response.get("variants", [])
            if not variants:
                logger.error(f"No variants found for prompt {prompt_id}.")
                return config_result
                
            template_config = variants[0].get("templateConfiguration", {})
            prompt_text = ""
            
            # Bedrock can return templates as either TEXT or CHAT depending on how it was created
            if "text" in template_config:
                prompt_text = template_config["text"].get("text", "")
                config_result["has_system_cache"] = "cachePoint" in template_config["text"]
                
            elif "chat" in template_config:
                # Extract system prompt and its cache point
                system_prompts = template_config["chat"].get("system", [])
                if system_prompts:
                    prompt_text = system_prompts[0].get("text", "")
                    config_result["has_system_cache"] = "cachePoint" in system_prompts[0]
                
                # Check if any tool in the prompt configuration has a cache point
                tools = template_config["chat"].get("toolConfiguration", {}).get("tools", [])
                config_result["has_tool_cache"] = any("cachePoint" in tool for tool in tools)

            if not prompt_text:
                logger.error("Prompt text is empty in the response.")
                return config_result

            # Inject dynamic variables
            for key, value in variables.items():
                prompt_text = prompt_text.replace(f"{{{{{key}}}}}", str(value))

            config_result["text"] = prompt_text
            logger.info(f"Successfully fetched prompt from Bedrock prompt management.")
            return config_result

        except Exception as e:
            if attempt < max_retries:
                logger.warning(f"Attempt {attempt} failed due to error: {e}. Retrying in 2 seconds...")
                time.sleep(2)
            else:
                logger.error(f"Failed to fetch configuration from Bedrock after {max_retries} attempts: {e}.")
                return config_result

# Fetch the combined configuration dictionary
PROMPT_DATA = get_bedrock_system_prompt(
    prompt_id=AWS_PROMPT_ID,
    prompt_version=AWS_PROMPT_VERSION,
    **dynamic_prompt_variables
)

