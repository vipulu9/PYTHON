import os
import requests
from collections import namedtuple
from strands.models.bedrock import BedrockModel
from dotenv import load_dotenv

load_dotenv()

AWS_GUARDRAIL_IDENTIFIER = os.getenv("AWS_GUARDRAIL_IDENTIFIER", "")

# The endpoint generated by API Gateway or AWS Lambda Function URLs
CONFIG_API_URL = os.getenv("CONFIG_API_URL", "https://<your-api-id>.execute-api.us-east-1.amazonaws.com/config") 

def load_model(agent_name: str = "agent1") -> BedrockModel:

    # 1. Fetch configuration from the database via FastAPI Lambda
    try:
        response = requests.get(f"{CONFIG_API_URL}/{agent_name}")
        response.raise_for_status()  # Throws an error for 404s or 500s
        db_config = response.json()
        print(f"Successfully loaded config for {agent_name} from Aurora DB.")
    
    except requests.exceptions.RequestException as e:
        print(f"Failed to fetch config from DB: {e}. Falling back to defaults.")
        # Fallback values ensure the agent doesn't break if the API is unreachable
        db_config = {
            "model_id": "global.anthropic.claude-sonnet-4-5-20250929-v1:0",
            "temperature": 0.20,
            "top_p": 0.95
        }

    StrandsCacheConfig = namedtuple(
        "CacheConfig",
        ["strategy", "ttl"]
    )

    # 2. Inject dynamic values into the BedrockModel
    return BedrockModel(
        model_id=db_config["model_id"],
        temperature=db_config.get("temperature"),
        top_p=db_config.get("top_p"),
        guardrail_id=AWS_GUARDRAIL_IDENTIFIER,
        guardrail_version="1",
        guardrail_trace="enabled",
        cache_tools="default"
    )
