from dotenv import load_dotenv
import os
import requests
from strands.models.bedrock import BedrockModel, CacheToolsConfig

load_dotenv()

AWS_GUARDRAIL_IDENTIFIER = os.getenv("AWS_GUARDRAIL_IDENTIFIER","")
CONFIG_API_URL = os.getenv("CONFIG_API_URL", "https://y2mccfntu2.execute-api.us-east-1.amazonaws.com/default/db_testing") 

def load_model(agent_name: str = "agent1", enable_tool_cache: bool = False) -> BedrockModel:
    
    try:
        response = requests.get(CONFIG_API_URL, params={"agent_name": agent_name})
        response.raise_for_status() 
        db_config = response.json()
        print(f"Successfully loaded config for {agent_name} from Aurora DB.")
    
    except requests.exceptions.RequestException as e:
        print(f"Failed to fetch config from DB: {e}. Falling back to defaults.")
        db_config = {
            "model_id": "global.anthropic.claude-sonnet-4-5-20250929-v1:0",
            "temperature": 0.20,
            "top_p": 0.95
        }
        
    # Build base model configuration
    model_kwargs = {
        "model_id": db_config["model_id"],
        "guardrail_id": AWS_GUARDRAIL_IDENTIFIER,
        "guardrail_version": "1",
        "guardrail_trace": "enabled"
    }
    
    # Dynamically inject tool caching if enabled via Bedrock Prompt Management
    if enable_tool_cache:
        model_kwargs["cache_tools"] = CacheToolsConfig(
            type="default",
            ttl="1h"
        )
        print("Tool caching dynamically enabled from Bedrock Prompt config.")
        
    return BedrockModel(**model_kwargs)
